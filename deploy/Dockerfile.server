ARG SERVER_BASE_IMAGE=docker.m.daocloud.io/library/eclipse-temurin:17-jre-jammy
FROM ${SERVER_BASE_IMAGE}

RUN groupadd --system app \
    && useradd --system --gid app --home-dir /opt/app --create-home app

WORKDIR /opt/app
COPY artifacts/*.jar app.jar
RUN chown app:app app.jar

USER app
EXPOSE 18080
ENTRYPOINT ["java", "-jar", "/opt/app/app.jar"]
