ARG COLLECTOR_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
FROM ${COLLECTOR_BASE_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN groupadd --system app \
    && useradd --system --gid app --home-dir /opt/app --create-home app

WORKDIR /opt/app
COPY artifacts/*.whl /tmp/
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install /tmp/training_plan_collector-*.whl \
    && rm /tmp/training_plan_collector-*.whl

USER app
EXPOSE 18090
ENTRYPOINT ["training-plan-collector"]
