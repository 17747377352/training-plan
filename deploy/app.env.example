# Copy this file to /opt/training-plan/shared/app.env on the server.
# Use KEY=value shell syntax, do not add spaces around '='. Then run:
#   chmod 600 /opt/training-plan/shared/app.env
# Never commit the real file. Generate secrets with: openssl rand -base64 48

# Dedicated MySQL account for the training_plan database (do not use root).
SPRING_DATASOURCE_USERNAME=training_plan_app
SPRING_DATASOURCE_PASSWORD=replace-with-database-password

# Password of the existing Redis instance on 127.0.0.1:16379.
SPRING_DATA_REDIS_PASSWORD=replace-with-redis-password
COLLECTOR_REDIS_PASSWORD=replace-with-the-same-redis-password

# Application secrets. TOKEN_CIPHER_KEY must exactly match the key that encrypted
# the existing garmin_account.token_ciphertext rows; changing it loses token access.
JWT_SECRET=replace-with-at-least-32-random-bytes
TOKEN_CIPHER_KEY=replace-with-the-existing-local-token-cipher-key

# Both sides of the internal server/collector channel must use the same value.
COLLECTOR_SERVICE_TOKEN=replace-with-random-internal-service-token
COLLECTOR_SERVER_TOKEN=replace-with-the-same-internal-service-token

# Public self-service registration. Keep false unless intentionally opening signup.
REGISTRATION_ENABLED=false

# Optional AI service. Leave the API key empty to disable real model calls.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_DAILY_LIMIT=8
