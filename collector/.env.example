COLLECTOR_ENV=dev
COLLECTOR_REDIS_HOST=127.0.0.1
COLLECTOR_REDIS_PORT=6379
COLLECTOR_REDIS_DATABASE=5
COLLECTOR_REDIS_PASSWORD=请填写本地Redis密码
COLLECTOR_TASK_QUEUE=training-plan:sync:jobs
COLLECTOR_SERVER_BASE_URL=http://127.0.0.1:8080
COLLECTOR_SERVER_TOKEN=请填写内部服务令牌

COLLECTOR_INTERNAL_HOST=127.0.0.1
COLLECTOR_INTERNAL_PORT=8090
COLLECTOR_MFA_SESSION_TTL_SECONDS=600
# Garmin 登录被限流或遇到人机挑战后的冷却时间，期间不再发起任何 Garmin 请求
COLLECTOR_RATE_LIMIT_COOLDOWN_SECONDS=900
# 设为 1 可关闭 Cloudflare 挑战绕过（仅用于定位问题是否由该绕过引入）
# COLLECTOR_DISABLE_CLOUDFLARE_BYPASS=1
